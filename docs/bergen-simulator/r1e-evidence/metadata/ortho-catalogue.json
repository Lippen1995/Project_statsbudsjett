{"MapOnlyWms":true,"Abstract":"Ortofoto er flybilder med de samme geometriske egenskaper som et kart og kan knyttes til et referansesystem. Ortofotoene dekker hele landet med varierende oppløsning og nøyaktighet. Bilder over by- og utbyggingsområder har som regel best oppløsning og nøyaktighet. Bildeprosjektene varierer i utstrekning, fra små prosjekter i en kommune, til store prosjekter som kan dekke hele regioner.","BoundingBox":{"EastBoundLongitude":"33,00","NorthBoundLatitude":"72,00","SouthBoundLatitude":"57,00","WestBoundLongitude":"2,00"},"Constraints":{"AccessConstraints":"Norge digitalt begrenset","OtherConstraints":"ingen juridiske begrensninger","OtherConstraintsLink":"https://www.kartverket.no/geodataarbeid/norge-digitalt/partsinformasjon/avtaler-og-vilkar/norge-digitalt-lisens","OtherConstraintsLinkText":"Norge digitalt-lisens","SecurityConstraints":"Ugradert","SecurityConstraintsNote":"","UseConstraints":"Lisens","UseLimitations":"Ingen begrensninger på bruk er oppgitt.","OtherConstraintsAccess":"http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1d"},"ContactMetadata":{"Email":"kundesenter@kartverket.no","Name":"Jon Arne Trollvik","Organization":"Kartverket","Role":"pointOfContact"},"ContactOwner":{"Email":"kundesenter@kartverket.no","Name":"Kundesenter","Organization":"Kartverket","Role":"owner"},"Organization":"Kartverket","ContactOwners":[{"Email":"kundesenter@kartverket.no","Name":"Kundesenter","Organization":"Kartverket","Role":"owner"}],"ContactPublisher":{"Email":"kundesenter@kartverket.no","Name":"Trond Ola Ulvolden","Organization":"Kartverket","Role":"publisher"},"DateMetadataUpdated":"2026-05-08T00:00:00","DatePublished":"2014-02-20T00:00:00","DateUpdated":"2017-01-17T00:00:00","DistributionDetails":{"Protocol":"WWW:LINK-1.0-http--link","ProtocolName":"Webside","URL":"https://www.norgeibilder.no"},"DistributionProtocol":"WWW:LINK-1.0-http--link","Protocol":"Webside","DistributionFormats":[{"Na