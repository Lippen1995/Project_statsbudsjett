{
  "name": "fellestall",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test scripts/neon/*.test.mjs scripts/deploy/*.test.mjs scripts/admin/*.test.mjs",
    "admin:setup": "node --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.admin.local scripts/admin/setup.mjs",
    "analysis:pipeline": "node scripts/analyser/pipeline-cli.mjs",
    "data:roundtrip": "node --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/neon/data-cli.mjs roundtrip",
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web run dev --",
    "preview": "npm --prefix web run preview --",
    "neon:init": "neon init -y --org-id org-icy-violet-87182384 --project-id bitter-firefly-21339346 --branch production --services postgres",
    "neon:deploy": "neon deploy --project-id bitter-firefly-21339346 --branch production",
    "db:check": "node --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/neon/check.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "^1.7.11",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  }
}
