# Opprettes automatisk med hemmelige verdier av neon deploy etter innlogging.
# Ikke bruk VITE_-prefiks: disse adressene skal aldri inngå i nettleserbygget.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Bare serveren. Bruk en tilfeldig hemmelighet på minst 32 tegn.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Prosjektavgrenset GitHub-token: Contents read/write og Actions read.
# Brukes til å redigere Svens eksisterende arbeidsfiler på main.
FELLESTALL_GITHUB_TOKEN=
